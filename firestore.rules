rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Foods: anyone logged in can read, only admins can write (seeded at registration)
    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.isCustom == true
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Users: only the owner
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Meal logs: only the owner
    match /mealLogs/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Favorites: only the owner
    match /favorites/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
